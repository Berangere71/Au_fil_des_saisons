{% extends 'base.html.twig' %}

{% block title %}Lien de réinitialisation envoyé{% endblock %}

{% block hero_title %}Consultez votre messagerie{% endblock %}

{% block body %}
    {% include 'components/_page_close.html.twig' with {return_route: 'app_login'} %}
    <section class="auth-container">
        <div class="auth-card auth-card--message">
            <p class="alert alert-info" role="status">
                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                <span>Si un compte correspond à cette adresse, un message contenant un lien de réinitialisation vient d’être envoyé.</span>
            </p>
            <p class="auth-description">
                Ce lien expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
            </p>
            <p class="auth-footer">
                Vous n’avez rien reçu ? Vérifiez vos courriers indésirables ou
                <a href="{{ path('app_forgot_password_request') }}">effectuez une nouvelle demande</a>.
            </p>
        </div>
    </section>
{% endblock %}
