{% extends 'base.html.twig' %}

{% block title %}Choisir un nouveau mot de passe{% endblock %}

{% block hero_title %}Nouveau mot de passe{% endblock %}

{% block body %}
    {% include 'components/_page_close.html.twig' with {return_route: 'app_login'} %}
    <section class="auth-container">
        <div class="auth-card">
            <p class="auth-description">Choisissez un mot de passe sécurisé que vous n’utilisez pas sur un autre site.</p>
            {{ form_start(resetForm) }}
                {{ form_row(resetForm.plainPassword) }}
                <button class="btn btn-primary">Enregistrer le nouveau mot de passe</button>
            {{ form_end(resetForm) }}
        </div>
    </section>
{% endblock %}
