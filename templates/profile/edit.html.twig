{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block hero_title %}Modifier mon profil{% endblock %}

{% block page_hero %}
    {% include 'components/_hero.html.twig' with {hero_title: block('hero_title'), hero_class: 'hero--compact'} %}
{% endblock %}

{% block main_class %}profile-edit-main{% endblock %}

{% block body %}

<section class="profile">
    {% include 'components/_page_close.html.twig' with {return_route: 'app_profile'} %}

    {% for message in app.flashes('success') %}
        <div class="alert-success">
            {{ message }}
        </div>
    {% endfor %}

    {{ form_start(profileForm, {attr: {class: 'profile-edit-form'}}) }}

        {{ form_row(profileForm.photoFile) }}

        {{ form_row(profileForm.prenom) }}

        {{ form_row(profileForm.nom) }}

        {{ form_row(profileForm.email) }}

        <div class="profile-form-actions">
            <button class="btn" type="submit">Enregistrer</button>

            <a href="{{ path('app_profile') }}" class="btn">
                Retour au profil
            </a>
        </div>

    {{ form_end(profileForm) }}

</section>

{% endblock %}
