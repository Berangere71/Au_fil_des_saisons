{{ form_start(form, {
    attr: {
        class: 'product-form',
        enctype: 'multipart/form-data'
    }
}) }}

<div class="product-form-content">

    <div class="product-left">

        <div class="product-image-card">

            {% if form.vars.data.photo %}
                <img
                    src="{{ asset('uploads/products/' ~ form.vars.data.photo) }}"
                    alt="{{ form.vars.data.nom }}"
                    class="product-preview">
            {% else %}
                <div class="product-placeholder">
                    <i class="fa-solid fa-image"></i>
                    <span>Aucune image</span>
                </div>
            {% endif %}

        </div>

        <div class="upload-field">
            {{ form_label(form.photoFile) }}
            {{ form_widget(form.photoFile) }}
            {{ form_errors(form.photoFile) }}
        </div>

    </div>

    <div class="product-right">

        <div class="form-group">
            {{ form_label(form.nom) }}
            {{ form_widget(form.nom) }}
            {{ form_errors(form.nom) }}
        </div>

        <div class="form-group">
            {{ form_label(form.category) }}
            {{ form_widget(form.category) }}
            {{ form_errors(form.category) }}
        </div>

        <div class="row">

            <div class="form-group half">
                {{ form_label(form.debutRecolteMois) }}
                {{ form_widget(form.debutRecolteMois) }}
                {{ form_errors(form.debutRecolteMois) }}
            </div>

            <div class="form-group half">
                {{ form_label(form.finRecolteMois) }}
                {{ form_widget(form.finRecolteMois) }}
                {{ form_errors(form.finRecolteMois) }}
            </div>

        </div>

        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="form-group">
            {{ form_label(form.conservation) }}
            {{ form_widget(form.conservation) }}
            {{ form_errors(form.conservation) }}
        </div>

    </div>

</div>

<div class="season-block">
    <h3>Saisons</h3>
    <p>La saison principale est déduite automatiquement du mois de début de récolte. Les saisons associées sont mises à jour à l’enregistrement.</p>
</div>

<div class="recipe-block">

    <h3>Recettes associées</h3>
    <p class="recipe-block__hint js-product-recipe-message">Saisissez le nom du produit pour filtrer automatiquement les recettes associées.</p>

    <div class="recipe-list">
        {{ form_widget(form.recettes) }}
        {{ form_errors(form.recettes) }}
    </div>

</div>

<div class="form-buttons">

    <a href="{{ path('app_product_index') }}" class="btn-cancel">
        Annuler
    </a>

    <button type="submit" class="btn-save">
        Enregistrer
    </button>

</div>

{{ form_end(form) }}
