<footer class="footer">

    <a href="{{ path('app_home') }}" class="footer-link">
        <img src="{{ asset('images/icons/home.svg') }}" alt="Accueil">
    </a>

    {% if app.user %}
        <a href="{{ path('app_profile') }}" class="footer-link">
            <img src="{{ asset('images/icons/profile.svg') }}" alt="Mon profil">
        </a>
    {% else %}
        <a href="{{ path('app_login') }}" class="footer-link">
            <img src="{{ asset('images/icons/profile.svg') }}" alt="Connexion">
        </a>
    {% endif %}

    <a href="{{ path('app_product_index') }}" class="footer-link">
        <img src="{{ asset('images/icons/search.svg') }}" alt="Produits">
    </a>

</footer>