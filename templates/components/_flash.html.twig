{% for label, messages in app.flashes %}
    {% for message in messages %}
        {% set alertType = label == 'reset_password_error' ? 'danger' : label %}
        {% set alertIcon = {
            success: 'fa-circle-check',
            danger: 'fa-circle-exclamation',
            warning: 'fa-triangle-exclamation',
            info: 'fa-circle-info'
        }[alertType]|default('fa-leaf') %}
        <div class="alert alert-{{ alertType }}" role="{{ alertType == 'danger' ? 'alert' : 'status' }}" aria-live="polite">
            <i class="fa-solid {{ alertIcon }}" aria-hidden="true"></i>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
{% endfor %}
