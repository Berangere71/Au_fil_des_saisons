<header class="site-header">

	<a href="{{ path('app_home') }}" class="logo-link">
		<img src="{{ asset('images/logo/logo.png') }}" class="logo" alt="Au fil des saisons">
	</a>

	<div class="header-actions">

		<button class="header-button" type="button">
			<img src="{{ asset('images/icons/Menu.svg') }}" alt="Menu">
		</button>

		{% if app.user %}

			{% if app.request.attributes.get('_route') == 'app_profile' %}

				<a href="{{ path('app_logout') }}" class="header-button">
					<img src="{{ asset('images/icons/Deconnected.svg') }}" alt="Déconnexion">
				</a>

			{% else %}

				<a href="{{ path('app_profile') }}" class="header-button">
					<img src="{{ asset('images/icons/profile.svg') }}" alt="Mon profil">
				</a>

			{% endif %}

		{% else %}

			<a href="{{ path('app_login') }}" class="header-button">
				<img src="{{ asset('images/icons/profile.svg') }}" alt="Connexion">
			</a>

		{% endif %}

	</div>

</header>
