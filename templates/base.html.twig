<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>
            {% block title %}Au fil des saisons{% endblock %}
        </title>

        <link rel="icon" href="{{ asset('images/logo/favicon.png') }}">

        {# =========================
            FEUILLES DE STYLE
        ========================== #}

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('css/style.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components.css') }}">
            <link rel="stylesheet" href="{{ asset('css/profile.css') }}">
            <link rel="stylesheet" href="{{ asset('css/profile-recettes.css') }}">
            <link rel="stylesheet" href="{{ asset('css/product.css') }}">
            <link rel="stylesheet" href="{{ asset('css/product-form.css') }}">
            <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
            <link rel="stylesheet" href="{{ asset('css/recette.css') }}">
            <link rel="stylesheet" href="{{ asset('css/recette-form-maquette.css') }}">
            <link rel="stylesheet" href="{{ asset('css/filters.css') }}">
            <link rel="stylesheet" href="{{ asset('css/recette-corrections.css') }}">
            <link rel="stylesheet" href="{{ asset('css/recette-social.css') }}">
            <link rel="stylesheet" href="{{ asset('css/recette-pending.css') }}">
            <link rel="stylesheet" href="{{ asset('css/responsive.css') }}">

            <style>
                body {
                    min-height: 100vh;
                    display: flex;
                    flex-direction: column;
                    margin: 0;
                }

                main.page-content {
                    flex: 1 0 auto;
                    width: 100%;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: flex-start;
                    padding: 0.75rem 1.25rem 1.5rem;
                    box-sizing: border-box;
                }

                main.page-content > * {
                    width: 100%;
                    max-width: 980px;
                    margin: 0 auto;
                }

                main.page-content form {
                    margin-top: 0 !important;
                    padding-top: 0 !important;
                }

                @media (max-width: 768px) {
                    main.page-content {
                        padding: 0.5rem 1rem 1rem;
                    }
                }
            </style>
        {% endblock %}

        {# =========================
            IMPORTMAP SYMFONY
        ========================== #}

        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}

        {# =========================
            FRANKENPHP HOT RELOAD
        ========================== #}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}

        {% if frankenphpHotReload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    </head>

    <body>
        {# =========================
                HEADER
        ========================== #}

        {% block header %}
            {% include 'components/_header.html.twig' %}
        {% endblock %}

        {% block page_hero %}
            {% include 'components/_hero.html.twig' with {hero_title: block('hero_title')} %}
        {% endblock %}

        {# =========================
                MESSAGES FLASH
        ========================== #}

        {% include 'components/_flash.html.twig' %}

        {# =========================
                CONTENU DES PAGES
        ========================== #}

        <main class="page-content {% block main_class %}{% endblock %}">
            {% block body %}{% endblock %}
        </main>

        {# =========================
                FOOTER
        ========================== #}

        {% block footer %}
            {% include 'components/_footer.html.twig' %}
        {% endblock %}

        <script src="{{ asset('js/flash.js') }}"></script>
        <script src="{{ asset('js/product-category-filter.js') }}"></script>
        <script src="{{ asset('js/recipe-list-format.js') }}"></script>
    </body>
</html>
