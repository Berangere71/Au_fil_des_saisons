{% extends 'base.html.twig' %}

{% block title %}Créer un compte
{% endblock %}

{% block hero_title %}Créer un compte{% endblock %}

{% block body %}
	{% include 'components/_page_close.html.twig' with {return_route: 'app_home'} %}

	<div class="auth-container">
		<section class="auth-card" aria-labelledby="registration-subtitle">

			<p class="subtitle" id="registration-subtitle">
				Rejoignez la communauté Au fil des saisons
			</p>

			{{ form_errors(registrationForm) }}

			{{ form_start(registrationForm) }}

			{{ form_row(registrationForm.prenom) }}
			{{ form_errors(registrationForm.prenom) }}

			{{ form_row(registrationForm.nom) }}
			{{ form_errors(registrationForm.nom) }}

			{{ form_row(registrationForm.email) }}
			{{ form_errors(registrationForm.email) }}

			{{ form_label(registrationForm.plainPassword.first) }}
			<div class="password-field">
				{{ form_widget(registrationForm.plainPassword.first) }}
				<button type="button" class="password-toggle" aria-label="Afficher le mot de passe" aria-pressed="false" onclick="const input = this.parentElement.querySelector('input'); const visible = input.type === 'password'; input.type = visible ? 'text' : 'password'; this.setAttribute('aria-pressed', String(visible)); this.setAttribute('aria-label', visible ? 'Masquer le mot de passe' : 'Afficher le mot de passe'); this.querySelector('i').className = visible ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';">
					<i class="fa-solid fa-eye" aria-hidden="true"></i>
				</button>
			</div>

			{{ form_label(registrationForm.plainPassword.second) }}
			<div class="password-field">
				{{ form_widget(registrationForm.plainPassword.second) }}
				<button type="button" class="password-toggle" aria-label="Afficher le mot de passe" aria-pressed="false" onclick="const input = this.parentElement.querySelector('input'); const visible = input.type === 'password'; input.type = visible ? 'text' : 'password'; this.setAttribute('aria-pressed', String(visible)); this.setAttribute('aria-label', visible ? 'Masquer le mot de passe' : 'Afficher le mot de passe'); this.querySelector('i').className = visible ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';">
					<i class="fa-solid fa-eye" aria-hidden="true"></i>
				</button>
			</div>
			{{ form_errors(registrationForm.plainPassword) }}

			<div class="rgpd-container">
				<div class="rgpd-checkbox">
					{{ form_widget(registrationForm.agreeTerms) }}
					<div class="rgpd-text">
						<label for="{{ registrationForm.agreeTerms.vars.id }}">
							J’accepte les
							<a href="{{ path('app_cgu') }}">Conditions Générales d'Utilisation</a>
							et la
							<a href="{{ path('app_privacy') }}">Politique de confidentialité</a>.
						</label>
					</div>
					{{ form_errors(registrationForm.agreeTerms) }}
				</div>

				<button type="submit" class="btn">
					S’inscrire
				</button>
			</div>

			{{ form_end(registrationForm) }}

			<div class="auth-footer">
				Déjà un compte ?
				<a href="{{ path('app_login') }}">Se connecter</a>
			</div>
		</section>
	</div>

{% endblock %}
