{% extends 'base.html.twig' %}
{% block title %}Signalements{% endblock %}
{% block hero_title %}<i class="fa-solid fa-flag"></i> Signalements{% endblock %}

{% block body %}
<section class="admin-dashboard admin-user-management">
	{% include 'components/_page_close.html.twig' with {return_route: 'app_admin_dashboard'} %}

	<header class="admin-user-management__header">
		<div>
			<h1>Commentaires à vérifier</h1>
			<p>Affichage de tous les commentaires. Cliquez sur un commentaire pour ouvrir toutes les informations.</p>
		</div>
		<div class="admin-user-management__stats">
			<span><strong>{{ reportedRecettes|length }}</strong> recette{{ reportedRecettes|length > 1 ? 's' }} signalée{{ reportedRecettes|length > 1 ? 's' }}</span>
			<span><strong>{{ allAvis|length }}</strong> commentaire{{ allAvis|length > 1 ? 's' }} à traiter</span>
			<span><strong>{{ reportedAvisCount }}</strong> signalé{{ reportedAvisCount > 1 ? 's' }}</span>
		</div>
	</header>

	<section class="admin-rating-summary" aria-labelledby="reports-recipes-title">
		<h2 id="reports-recipes-title"><i class="fa-solid fa-utensils" aria-hidden="true"></i> Recettes signalées</h2>
		{% for recette in reportedRecettes %}
			<article class="recette-card">
				<div>
					<h3>{{ recette.titre }}</h3>
					<p><strong>Motif :</strong> {{ recette.motifSignalement ?: 'Aucun motif précisé.' }}</p>
					<p>
						<strong>Auteur :</strong>
						{% if recette.user %}
							{{ recette.user.prenom }} {{ recette.user.nom }}
							(<a href="{{ path('app_admin_users', {q: recette.user.email}) }}">gérer ce compte</a>)
						{% else %}
							Compte introuvable
						{% endif %}
					</p>
					<a href="{{ path('app_recette_show', {id: recette.id}) }}">Voir la recette</a>
				</div>
			</article>
		{% else %}
			<p class="admin-user-table__empty">Aucune recette signalée.</p>
		{% endfor %}
	</section>

	<section class="admin-rating-summary" aria-labelledby="reports-all-comments-title">
		<h2 id="reports-all-comments-title"><i class="fa-solid fa-comments" aria-hidden="true"></i> Commentaires à traiter</h2>
		<p>Liste des commentaires à vérifier. Cliquez sur "Marquer comme lu" pour les retirer de cette liste.</p>
		{% for avisItem in allAvis %}
			<details class="admin-report-panel"{{ loop.first ? ' open' }}>
				<summary>
					<span>
						<i class="fa-solid {{ avisItem.signale ? 'fa-triangle-exclamation' : 'fa-comment-dots' }}" aria-hidden="true"></i>
						{{ avisItem.commentaire ? avisItem.commentaire|slice(0, 70) ~ (avisItem.commentaire|length > 70 ? '…' : '') : 'Commentaire sans contenu' }}
					</span>
					<span class="admin-report-panel__count">{{ avisItem.signale ? 'Signalé' : 'Non signalé' }}</span>
				</summary>
				<div class="admin-report-panel__body">
					<article class="admin-report-comment-card">
						<div>
							<p><strong>Commentaire complet :</strong> {{ avisItem.commentaire ?: 'Aucun contenu.' }}</p>
							<p><strong>Date :</strong> {{ avisItem.createdAt|date('d/m/Y H:i') }}</p>
							<p><strong>Motif du signalement :</strong> {{ avisItem.motifSignalement ?: 'Aucun motif précisé.' }}</p>
							<p><strong>Type :</strong> {{ avisItem.parentAvis ? 'Réponse à un commentaire' : 'Commentaire principal' }}</p>
							<p>
								<strong>Auteur :</strong>
								{% if avisItem.user %}
									{{ avisItem.user.prenom }} {{ avisItem.user.nom }} ({{ avisItem.user.email }})
									· <a href="{{ path('app_admin_users', {q: avisItem.user.email}) }}">gérer ce compte</a>
								{% else %}
									Compte introuvable
								{% endif %}
							</p>
							<p><strong>Recette liée :</strong>
								{% if avisItem.recette %}
									<a href="{{ path('app_recette_show', {id: avisItem.recette.id}) }}">{{ avisItem.recette.titre }}</a>
								{% else %}
									Recette supprimée
								{% endif %}
							</p>
							{% if avisItem.note %}<p><strong>Note donnée :</strong> {{ avisItem.note }}/5</p>{% endif %}
							<form method="post" action="{{ path('app_admin_report_comment_archive', {avis: avisItem.id}) }}">
								<input type="hidden" name="_token" value="{{ csrf_token('archive-comment-' ~ avisItem.id) }}">
								<input type="hidden" name="archive" value="1">
								<button type="submit" class="admin-action-btn admin-action-btn--status">Marquer comme lu</button>
							</form>
						</div>
					</article>
				</div>
			</details>
		{% else %}
			<p class="admin-user-table__empty">Aucun commentaire à traiter.</p>
		{% endfor %}
	</section>
</section>
{% endblock %}
