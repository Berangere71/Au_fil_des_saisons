{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}
{% block hero_title %}<i class="fa-solid fa-users" aria-hidden="true"></i> Utilisateurs{% endblock %}

{% block body %}
<section class="admin-dashboard admin-user-management">
    {% include 'components/_page_close.html.twig' with {return_route: 'app_admin_dashboard'} %}

    <header class="admin-user-management__header">
        <div>
            <h1>Gestion des utilisateurs</h1>
            <p>Bloquez, débloquez et gérez les droits d’accès des comptes.</p>
        </div>
        <div class="admin-user-management__stats">
            <span><strong>{{ totalUsers }}</strong> compte{{ totalUsers > 1 ? 's' }}</span>
            <span><strong>{{ adminCount }}</strong> admin{{ adminCount > 1 ? 's' }}</span>
        </div>
    </header>

    <form class="admin-user-filters" method="get" action="{{ path('app_admin_users') }}">
        <label>
            Rechercher
            <input type="search" name="q" value="{{ search ?? '' }}" placeholder="Nom, prénom ou e-mail" maxlength="100">
        </label>
        <label>
            Rôle
            <select name="role">
                <option value="">Tous</option>
                <option value="utilisateur"{{ selectedRole and selectedRole.value == 'utilisateur' ? ' selected' }}>Utilisateur</option>
                <option value="administrateur"{{ selectedRole and selectedRole.value == 'administrateur' ? ' selected' }}>Administrateur</option>
            </select>
        </label>
        <label>
            Statut
            <select name="status">
                <option value="">Tous</option>
                <option value="active"{{ selectedStatus == 'active' ? ' selected' }}>Actif</option>
                <option value="blocked"{{ selectedStatus == 'blocked' ? ' selected' }}>Bloqué</option>
            </select>
        </label>
        <div class="admin-user-filters__actions">
            <button type="submit" class="admin-action-btn admin-action-btn--status">Filtrer</button>
            <a href="{{ path('app_admin_users') }}">Réinitialiser</a>
        </div>
    </form>

    {% set listQuery = {
        q: search ?: null,
        role: selectedRole ? selectedRole.value : null,
        status: selectedStatus ?: null,
        page: currentPage > 1 ? currentPage : null
    } %}

    <div class="admin-user-table-wrap">
        <table class="admin-user-table">
            <caption>Liste des utilisateurs et gestion de leurs accès</caption>
            <thead>
                <tr>
                    <th scope="col">Utilisateur</th>
                    <th scope="col">Rôle</th>
                    <th scope="col">Statut</th>
                    <th scope="col">Inscription</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for managedUser in users %}
                    {% set isCurrent = app.user and app.user.id == managedUser.id %}
                    <tr>
                        <td>
                            <div class="admin-user-identity">
                                <strong>{{ managedUser.prenom }} {{ managedUser.nom }}</strong>
                                <span>{{ managedUser.email }}</span>
                            </div>
                        </td>
                        <td>
                            <span class="admin-user-badge {{ managedUser.role.value == 'administrateur' ? 'admin-user-badge--admin' : 'admin-user-badge--user' }}">
                                {{ managedUser.role.value == 'administrateur' ? 'Administrateur' : 'Utilisateur' }}
                            </span>
                        </td>
                        <td>
                            <span class="admin-user-badge {{ managedUser.isBlocked ? 'admin-user-badge--blocked' : 'admin-user-badge--active' }}">
                                {{ managedUser.isBlocked ? 'Bloqué' : 'Actif' }}
                            </span>
                        </td>
                        <td>{{ managedUser.createdAt|date('d/m/Y') }}</td>
                        <td>
                            <div class="admin-user-actions">
                                {% if isCurrent %}
                                    <span class="admin-user-note">Compte connecté</span>
                                {% else %}
                                    <form method="post" action="{{ path('app_admin_user_toggle_block', listQuery|merge({id: managedUser.id})) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-block-user-' ~ managedUser.id) }}">
                                        <button type="submit" class="admin-action-btn admin-action-btn--status">
                                            {{ managedUser.isBlocked ? 'Débloquer' : 'Bloquer' }}
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('app_admin_user_toggle_role', listQuery|merge({id: managedUser.id})) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-role-user-' ~ managedUser.id) }}">
                                        <button type="submit" class="admin-action-btn admin-action-btn--role">
                                            {{ managedUser.role.value == 'administrateur' ? 'Rétrograder' : 'Promouvoir admin' }}
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="admin-user-table__empty">Aucun utilisateur trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if totalPages > 1 %}
        <nav class="admin-user-pagination" aria-label="Pagination des utilisateurs">
            <a href="{{ path('app_admin_users', {
                q: search ?: null,
                role: selectedRole ? selectedRole.value : null,
                status: selectedStatus ?: null,
                page: currentPage > 1 ? currentPage - 1 : 1
            }) }}" class="{{ currentPage == 1 ? 'is-disabled' }}"{{ currentPage == 1 ? ' aria-disabled="true" tabindex="-1"' }}>
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Précédent
            </a>
            <span>Page {{ currentPage }} / {{ totalPages }}</span>
            <a href="{{ path('app_admin_users', {
                q: search ?: null,
                role: selectedRole ? selectedRole.value : null,
                status: selectedStatus ?: null,
                page: currentPage < totalPages ? currentPage + 1 : totalPages
            }) }}" class="{{ currentPage == totalPages ? 'is-disabled' }}"{{ currentPage == totalPages ? ' aria-disabled="true" tabindex="-1"' }}>
                Suivant <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </a>
        </nav>
    {% endif %}
</section>
{% endblock %}
