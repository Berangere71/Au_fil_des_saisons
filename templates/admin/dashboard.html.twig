{% extends 'base.html.twig' %}

{% block title %}Tableau de bord administrateur{% endblock %}

{% block hero_title %}Mon profil administrateur{% endblock %}

{% block body %}
<section class="admin-dashboard">
    <div class="admin-dashboard-links">
        <a href="{{ path('app_product_index') }}"><i class="fa-solid fa-basket-shopping"></i> Gestion des produits</a>
        <a href="{{ path('app_admin_users') }}"><i class="fa-solid fa-user"></i> Gestion des utilisateurs</a>
        <a href="{{ path('app_recette_index') }}"><i class="fa-solid fa-utensils"></i> Gestion des recettes</a>
        <a href="{{ path('app_admin_reports') }}"><i class="fa-solid fa-flag"></i> Signalements</a>
    </div>

    <div class="admin-dashboard-counts">
        <div><strong>Produits</strong><span>{{ productCount }}</span></div>
        <div><strong>Utilisateurs</strong><span>{{ userCount }}</span></div>
        <div><strong>Recettes</strong><span>{{ recipeCount }}</span></div>
    </div>

    <section class="admin-rating-summary" aria-labelledby="admin-rating-title">
        <h2 id="admin-rating-title"><i class="fa-solid fa-star"></i> Notes cumulées des recettes</h2>
        <p>Chaque utilisateur compte une seule fois par recette. Une nouvelle note remplace sa note précédente.</p>
        <div class="admin-rating-table-wrap">
            <table class="admin-rating-table">
                <thead><tr><th>Recette</th><th>Note moyenne</th><th>Nombre de votes</th></tr></thead>
                <tbody>
                {% for rating in recipeRatings %}
                    <tr>
                        <td><a href="{{ path('app_recette_show', {id: rating.recette.id}) }}">{{ rating.recette.titre }}</a></td>
                        <td>{{ rating.average is null ? 'Pas encore notée' : rating.average|number_format(1, ',', ' ') ~ '/5' }}</td>
                        <td>{{ rating.count }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3">Aucune recette disponible.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</section>
{% endblock %}
